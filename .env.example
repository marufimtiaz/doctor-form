# ---- Local development (docker-compose.yml) ----
# Host port mappings
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5432
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Database (published on POSTGRES_PORT for direct GUI access)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Object storage credentials (defaults match RustFS's built-in admin user)
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
S3_BUCKET=uploads

# ---- Production (docker-compose.prod.yml, Coolify) ----
# Coolify generates these; do NOT set them by hand in the Coolify UI:
#   SERVICE_FQDN_FRONTEND_80   domain routed to the Caddy container
#   SERVICE_PASSWORD_RUSTFS    RustFS secret key, also given to the backend
#   SERVICE_PASSWORD_POSTGRES  Postgres password, also given to the backend
#
# Set RUSTFS_ACCESS_KEY and S3_BUCKET in Coolify's environment tab if you want
# something other than the defaults above.
