# ---- Local development (docker-compose.yml) ----
# Host port mappings
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5432
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Database (published on POSTGRES_PORT for direct GUI access)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Object storage credentials (defaults match RustFS's built-in admin user)
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
S3_BUCKET=uploads

# ---- Application ----
# Daily counts are reported per local day, not per UTC day.
APP_TIMEZONE=Asia/Dhaka

# Seeds the first admin on boot when the users table is empty. Identity is
# picked from the users list, so an empty list is an unusable system.
ADMIN_NAME=Admin
ADMIN_PHONE=+8801700000000

# Seeds three demo agents on a fresh database, so `docker compose down -v`
# does not leave you with only the admin. Local development only - these are
# usable identities in a system that does not check passwords.
SEED_DEMO_DATA=true

# ---- Authentication ----
# REQUIRED IN PRODUCTION. The app refuses to boot with the development default
# when DEBUG is false, and refuses any secret shorter than 32 characters: a
# known or weak signing key lets anyone forge an admin token.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-change-me-before-deploying

# Days before a signed-in user must sign in again.
ACCESS_TOKEN_TTL_DAYS=30

# REQUIRED IN PRODUCTION, for the same reason: the first admin is seeded with
# this password, and without a working one nobody can log in to create anybody.
ADMIN_PASSWORD=dev-only-admin-password

# Password given to the demo agents. Only read when SEED_DEMO_DATA is true.
DEMO_PASSWORD=demo-password

# ---- Production (docker-compose.prod.yml, Coolify) ----
# Coolify generates these; do NOT set them by hand in the Coolify UI:
#   SERVICE_FQDN_FRONTEND_80   domain routed to the Caddy container
#   SERVICE_PASSWORD_RUSTFS    RustFS secret key, also given to the backend
#   SERVICE_PASSWORD_POSTGRES  Postgres password, also given to the backend
#
# Set RUSTFS_ACCESS_KEY and S3_BUCKET in Coolify's environment tab if you want
# something other than the defaults above.
